# Для локального запуска.
# На Render эти значения лучше задавать в Dashboard -> Environment.

TELEGRAM_BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_HERE
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash

# Для локального запуска webhook не требуется.
# На Render RENDER_EXTERNAL_URL можно указать как https://ИМЯ.onrender.com
# WEBHOOK_SECRET=любая_длинная_случайная_строка
